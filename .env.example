# Copy into .env (never commit real keys).

# Required for Prisma (Postgres). On Railway this is set automatically
# when you add a Postgres plugin. Locally use Neon or Railway's public URL.
DATABASE_URL=

# Shopify (from: shopify app env show)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,write_app_proxy
SHOPIFY_APP_URL=

# Optional AI ranking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
