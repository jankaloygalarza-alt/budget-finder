{% comment %}
  Budget Finder — category chips, budget slider, ranked recommendations.
{% endcomment %}

{% assign category_list = block.settings.category_options | split: ',' %}

<div
  class="budget-finder"
  data-budget-finder
  data-proxy-url="/apps/budget-finder/recommend"
  data-empty-text="{{ block.settings.empty_text | escape }}"
  data-add-label="{{ block.settings.add_to_cart_label | escape }}"
  data-added-label="{{ block.settings.added_label | escape }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <h2 class="budget-finder__heading">{{ block.settings.heading }}</h2>
  {% endif %}

  {% if block.settings.subheading != blank %}
    <p class="budget-finder__subheading">{{ block.settings.subheading }}</p>
  {% endif %}

  <form class="budget-finder__form" data-budget-form>
    <fieldset class="budget-finder__categories">
      <legend class="budget-finder__label">{{ block.settings.category_label }}</legend>
      <div class="budget-finder__chips" role="group">
        <button
          type="button"
          class="budget-finder__chip is-active"
          data-budget-category=""
          aria-pressed="true"
        >
          All
        </button>
        {% for raw in category_list %}
          {% assign cat = raw | strip %}
          {% if cat != blank and cat != 'All' and cat != 'all' %}
            <button
              type="button"
              class="budget-finder__chip"
              data-budget-category="{{ cat | escape }}"
              aria-pressed="false"
            >
              {{ cat }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
      <input type="hidden" name="category" value="" data-budget-category-value>
    </fieldset>

    <div class="budget-finder__budget">
      <label class="budget-finder__budget-label" for="budget-finder-slider-{{ block.id }}">
        {{ block.settings.budget_label }}
      </label>
      <input
        id="budget-finder-slider-{{ block.id }}"
        class="budget-finder__slider"
        type="range"
        name="budget"
        min="{{ block.settings.slider_min }}"
        max="{{ block.settings.slider_max }}"
        step="{{ block.settings.slider_step }}"
        value="{{ block.settings.slider_default }}"
        data-budget-slider
      >
      <output class="budget-finder__budget-value" data-budget-value>
        ${{ block.settings.slider_default }}
      </output>
    </div>

    <button type="submit" class="budget-finder__submit" data-budget-submit>
      {{ block.settings.button_label }}
    </button>
  </form>

  <p class="budget-finder__status" data-budget-status hidden></p>
  <div class="budget-finder__results" data-budget-results></div>
</div>

{% schema %}
{
  "name": "Budget Finder",
  "target": "section",
  "stylesheet": "budget-finder.v5.css",
  "javascript": "budget-finder.v5.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find something in your budget"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Pick a category and budget to see matching products."
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Category label",
      "default": "Category"
    },
    {
      "type": "text",
      "id": "category_options",
      "label": "Categories",
      "default": "Backpacks, Bath Towels, Coin Purses, Cross Body Bags, Sandals",
      "info": "Comma-separated category chips."
    },
    {
      "type": "text",
      "id": "budget_label",
      "label": "Budget label",
      "default": "Budget"
    },
    {
      "type": "number",
      "id": "slider_min",
      "label": "Slider minimum",
      "default": 0
    },
    {
      "type": "number",
      "id": "slider_max",
      "label": "Slider maximum",
      "default": 100000
    },
    {
      "type": "number",
      "id": "slider_step",
      "label": "Slider step",
      "default": 100
    },
    {
      "type": "number",
      "id": "slider_default",
      "label": "Default budget",
      "default": 90
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Find button label",
      "default": "Show recommendations"
    },
    {
      "type": "text",
      "id": "add_to_cart_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "added_label",
      "label": "Added label",
      "default": "Added"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "No products found. Try another category or adjust your budget."
    }
  ]
}
{% endschema %}
